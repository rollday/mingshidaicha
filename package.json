{
  "name": "mingshidaicha-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "dev:frontend": "pnpm --dir frontend dev",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "build": "tsc -p tsconfig.json && pnpm --dir frontend build",
    "typecheck": "tsc --noEmit && pnpm --dir frontend typecheck",
    "test": "node --test tests/*.test.ts",
    "test:python": ".venv/bin/python -m unittest discover -s tests/python -v",
    "check:model": "node --env-file-if-exists=.env scripts/check-model.ts",
    "test:live": "node --env-file-if-exists=.env scripts/smoke.ts",
    "test:full": "node --env-file-if-exists=.env scripts/full-smoke.ts",
    "test:images": "node --env-file-if-exists=.env scripts/full-smoke.ts --image"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openai": "^7.43.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
